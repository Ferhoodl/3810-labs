-- tb_dffg.vhd
-------------------------------------------------------------------------
-- DESCRIPTION: This file contains a simple VHDL testbench for the a
-- 5-to-32 bit decoder.
--
--
-- 9/16/2026: created
-------------------------------------------------------------------------

library IEEE;
use IEEE.std_logic_1164.all;

entity tb_dffg is
  generic(gCLK_HPER   : time := 50 ns);
end tb_dffg;

architecture behavior of tb_decoder_5t32 is
  
  -- Calculate the clock period as twice the half-period
  constant cCLK_PER  : time := gCLK_HPER * 2;


  component dffg
    port(tb_DC_IN     : in std_logic_vector(4 downto 0);
         tb_DC_OUT    : out std_logic_vector(31 downto 0));
  end component;

  -- Temporary signals to connect to the dff component.
  signal DC_IN  : std_logic_vector(4 downto 0);
  signal DC_OUT    : std_logic_vector(31 downto 0);

begin

  DUT: decoder_5t32 
  port map(DC_IN => tb_DC_IN, 
           DC_OUT => tb_DC_IN);

  
  -- Testbench process  
  P_TB: process
  begin

    -- Test case 0:
    tb_DC_IN <= "00000";
    wait for cCLK_PER;
    wait for cCLK_PER;

    -- Test case 1:
    tb_DC_IN <= "00001";
    wait for cCLK_PER;
    wait for cCLK_PER;

    -- Test case 2:
    tb_DC_IN <= "00010";
    wait for cCLK_PER;
    wait for cCLK_PER;

    -- Test case 3:
    tb_DC_IN <= "00011";
    wait for cCLK_PER;
    wait for cCLK_PER;

    -- Test case 4:
    tb_DC_IN <= "00100";
    wait for cCLK_PER;
    wait for cCLK_PER;


    wait;
  end process;
  
end behavior;